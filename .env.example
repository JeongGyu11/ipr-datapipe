# PostgreSQL: 상품공시 문서 수집 DB
RS_DB_HOST=localhost
RS_DB_PORT=5432
RS_DB_USER=postgres
RS_DB_PASSWORD=change-me
RS_DB_NAME=postgres
RS_DB_SSLMODE=prefer
RS_DB_CONNECT_TIMEOUT=10

# Docker Compose 파일 서버 bind mount의 호스트 경로입니다.
# 반드시 상품공시실문서 폴더의 부모인 IPR 경로를 지정하세요.
CRAWLER_OUTPUT_HOST_PATH=/mnt/fileserver/FAS/7.제안공유/04. 진행중/349.밀리만/상품리서치 Ai Agent/IPR

# Docker Compose 호스트에서 노출할 API 포트입니다. 컨테이너 내부 API는 8000번으로 고정됩니다.
API_PORT=8000

# 내장 APScheduler 설정 (기본: 매일 03:00, 전날 하루 수집)
IPR_SCHEDULE_CRON=0 3 * * *
IPR_SCHEDULE_TIMEZONE=Asia/Seoul
IPR_SCHEDULE_PERIOD_MODE=previous_day
IPR_SCHEDULE_COMPANIES=
IPR_SCHEDULE_TARGET_MONTH=
IPR_SCHEDULE_START_DATE=
IPR_SCHEDULE_END_DATE=
IPR_SCHEDULE_MISFIRE_GRACE=3600

# 컨테이너 종료 시 수집 정리 대기 시간
API_STOP_GRACE_PERIOD=30m
COLLECTOR_STOP_GRACE_PERIOD=30m

# 공통 애플리케이션 로그 디렉터리 (로컬 기본값, Docker에서는 Compose가 별도 경로 사용)
IPR_LOG_DIR=logs
LOG_LEVEL=INFO

# PDF Load 헤더·푸터 자동 제거 (기본 OFF)
PDF_LOAD_HEADER_FOOTER_ENABLED=false

# PDF Load 표 LLM 재구성 (개발 환경에서만 명시적으로 ON)
PDF_LOAD_TABLE_RECONSTRUCTION_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=8192
